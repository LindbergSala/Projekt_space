generator client {
  // Unlike the default "prisma-client" generator, this emits runnable JavaScript directly.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  factionKey    String?   @db.VarChar(32)
  sessions      Session[]
  accounts      Account[]
  ownedPlanets  Planet[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Planet {
  id                           String                      @id
  name                         String                      @default("Unnamed Planet") @db.VarChar(40)
  materials                    BigInt                      @default(0) @db.BigInt
  materialsProductionCursor    DateTime                    @default(now()) @db.Timestamp(3)
  materialsProductionRemainder BigInt                      @default(0) @db.BigInt
  infrastructureEpoch          String                      @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId                      String
  owner                        User                        @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  materialTransactions         PlanetMaterialTransaction[]
  unitStacks                   PlanetUnitStack[]
  unitTransactions             PlanetUnitTransaction[]
  constructions                PlanetConstruction[]

  @@index([ownerId])
  @@map("planet")
}

model PlanetConstruction {
  id            String   @id
  planetId      String
  buildingKey   String   @db.VarChar(32)
  fromLevel     Int
  targetLevel   Int
  startedAt     DateTime @db.Timestamp(3)
  completesAt   DateTime @db.Timestamp(3)
  materialsCost BigInt   @db.BigInt
  planet        Planet   @relation(fields: [planetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([planetId, buildingKey, targetLevel], map: "planet_construction_level_key")
  @@index([planetId, completesAt], map: "planet_construction_completion_idx")
  @@map("planet_construction")
}

model PlanetUnitStack {
  planetId String
  unitKey  String @db.VarChar(32)
  quantity BigInt @default(0) @db.BigInt
  planet   Planet @relation(fields: [planetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([planetId, unitKey], map: "planet_unit_stack_pkey")
  @@map("planet_unit_stack")
}

model PlanetUnitTransaction {
  id            String   @id
  planetId      String
  unitKey       String   @db.VarChar(32)
  delta         BigInt   @db.BigInt
  quantityAfter BigInt   @db.BigInt
  createdAt     DateTime @default(now())
  planet        Planet   @relation(fields: [planetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([planetId, createdAt, id], map: "planet_unit_history_idx")
  @@map("planet_unit_transaction")
}

model PlanetMaterialTransaction {
  id           String   @id
  planetId     String
  delta        BigInt   @db.BigInt
  balanceAfter BigInt   @db.BigInt
  createdAt    DateTime @default(now())
  planet       Planet   @relation(fields: [planetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([planetId, createdAt, id], map: "planet_material_history_idx")
  @@map("planet_material_transaction")
}
