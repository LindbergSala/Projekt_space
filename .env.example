# Administrative settings for the isolated local PostgreSQL service.
# Copy this value to .env.postgres.local and replace the placeholder with a
# unique local password. Never use the administrative role at application
# runtime, and never commit or share populated credential files.
PROJEKT_SPACE_POSTGRES_PASSWORD=

# Restricted local application settings. The setup script writes the real
# values to the ignored .env.local file. These Docker URLs and the shadow URL
# are development-only and must not be copied to Vercel.
DATABASE_URL=postgresql://projekt_space_app:replace-with-generated-password@127.0.0.1:55432/projekt_space_dev
MIGRATION_DATABASE_URL=postgresql://projekt_space_migrator:replace-with-generated-password@127.0.0.1:55432/projekt_space_dev
SHADOW_DATABASE_URL=postgresql://projekt_space_app:replace-with-generated-password@127.0.0.1:55432/projekt_space_shadow

# On Vercel, DATABASE_URL must be the pooled URL for that environment's Neon
# branch. Map Neon's direct/unpooled value to MIGRATION_DATABASE_URL only in
# the separately authorized migration context. Never give Preview the
# Production branch URL, and do not configure SHADOW_DATABASE_URL on Vercel.

# Better Auth server settings. Replace the secret placeholder with a random,
# high-entropy value of at least 32 characters. The application rejects this
# literal placeholder. Keep the local URL aligned with the development server.
# Production requires an explicit HTTPS BETTER_AUTH_URL. Preview derives its
# HTTPS origin from Vercel's validated VERCEL_URL system value; do not set a
# Production BETTER_AUTH_URL for Preview.
BETTER_AUTH_SECRET=replace-with-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth settings. Leave both empty to disable Google, or set
# both together. Never commit real provider credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
